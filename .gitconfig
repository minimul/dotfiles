[user]
  name = minimul
  email = christian@minimul.com
[core]
  editor = nvim
  excludesfile = ~/.global_gitignore
  attributesfile = ~/.gitattributes
[diff]
[color]
  ui = auto
[alias]
  st = status
  sh = stash
  ci = commit
  br = branch
  co = checkout
  pp = log --pretty=oneline
  di = diff
  dc = diff --cached
  po = push origin
  pf = push --force-with-lease
  pom = push origin master
  pum = pull origin master
  puum = pull upstream master
  fup = fetch upstream
  com = checkout master
  # `git log` with patches shown with difftastic.
  dl = -c diff.external=difft log -p --ext-diff
  # Show the most recent commit with difftastic.
  ds = -c diff.external=difft show --ext-diff
  # `git diff` with difftastic.
  dft = -c diff.external=difft diff
  # It allows you to go to a branch and write `git squash main` to have the current state of your branch in a fresh commit on top of `main` without dealing with merge rebase conflicts.
  squash = "!f() { git merge --no-edit origin/\"$1\" && git reset --soft origin/\"$1\" && git commit -m \"${2:-$(git log --reverse --format=%B origin/\"$1\"..ORIG_HEAD)}\"; }; f"
[merge]
  tool = vimdiff
[github]
  user = minimul
[filter "lfs"]
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f
[commit]
  template = ~/.gitmessage
